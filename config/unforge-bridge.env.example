# Local Unforge r239 <-> Codex API bridge with microphone dictation.
# The client still connects only to the loopback bridge. Keep the API key
# in the process environment; do not write it to this repository.
UNFORGE_BRIDGE_BIND=127.0.0.1
UNFORGE_BRIDGE_WS_PORT=18901
UNFORGE_BRIDGE_HTTP_PORT=18900
UNFORGE_OPENAI_BASE_URL=https://api.openai.com
# Use either UNFORGE_OPENAI_API_KEY or the standard OPENAI_API_KEY.
UNFORGE_OPENAI_API_KEY=replace-with-local-environment-secret
UNFORGE_CODEX_MODEL=gpt-5-codex
UNFORGE_TRANSCRIPTION_MODEL=gpt-transcribe
UNFORGE_BRIDGE_CONNECT_TIMEOUT_MS=5000
UNFORGE_BRIDGE_REQUEST_TIMEOUT_MS=180000
UNFORGE_BRIDGE_MAX_TEXT_CHARS=8000
UNFORGE_BRIDGE_MAX_CONCURRENT_TASKS=2
UNFORGE_BRIDGE_MAX_AUDIO_BYTES=5000000
